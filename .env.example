# ---- LLM provider -----------------------------------------------------------
# One of: ollama | gemini | claude | extractive
LLM_PROVIDER=ollama

# Ollama (local, free) — install from https://ollama.com, then: ollama pull qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=8192
# Thinking mode for reasoning models such as Qwen3.5 (slower; answers are grounded in passages anyway)
OLLAMA_THINK=false

# Google Gemini — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude — key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-opus-5-5 (most capable) | claude-sonnet-5-5 | claude-haiku-5-5 (cheapest, good for evaluation runs)
CLAUDE_MODEL=claude-opus-5-5
# Reasoning depth for Claude: low | medium | high
CLAUDE_EFFORT=medium

# Temperature applies to Ollama and Gemini (current Claude models do not accept it)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=180

# ---- Retrieval --------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
# Skip the LLM when the best chunk's cosine similarity is below this value (calibrated in evaluation/RESULTS.md)
MIN_SIMILARITY=0.30
# Drop bibliography text before indexing (reference lists match many queries but rarely answer them)
SKIP_REFERENCES=true
# When several papers are searched, guarantee each relevant paper at least one passage
BALANCE_DOCUMENTS=true
MAX_CONTEXT_CHARS=20000
# Second stage (recommended): ms-marco reorders the best RERANK_CANDIDATES passages, and the Laya model
# judges whether the final passages answer the question. Set both to none for plain cosine search
# (lighter: no extra model downloads, but short questions are often refused).
# Rerankers: none, ms-marco, bge or laya. RERANK_GATE: none (the reranker judges) or one of the same models.
# With a reranker or gate, RERANK_MIN_SCORE (0 to 1) replaces MIN_SIMILARITY as the insufficient-evidence cutoff.
# See "Reranker comparison" in evaluation/RESULTS.md for measured results and cutoffs.
RERANKER=ms-marco
RERANK_GATE=laya
RERANK_CANDIDATES=20
RERANK_MIN_SCORE=0.35

# Rewrite follow-up and Arabic questions into a standalone English search query (one extra LLM call, only when needed)
QUERY_REWRITING=true
