# ---- LLM provider -----------------------------------------------------------
# One of: ollama | gemini | claude | extractive
LLM_PROVIDER=ollama

# Ollama (local, free) — install from https://ollama.com, then: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192

# Google Gemini — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude — key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-opus-5-5 (most capable) | claude-sonnet-5-5 | claude-haiku-5-5 (cheapest, good for evaluation runs)
CLAUDE_MODEL=claude-opus-5-5
# Reasoning depth for Claude: low | medium | high
CLAUDE_EFFORT=medium

# Temperature applies to Ollama and Gemini (current Claude models do not accept it)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=180

# ---- Retrieval --------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
# Skip the LLM when the best chunk's cosine similarity is below this value (calibrated in evaluation/RESULTS.md)
MIN_SIMILARITY=0.30
# Drop bibliography text before indexing (reference lists match many queries but rarely answer them)
SKIP_REFERENCES=true
MAX_CONTEXT_CHARS=20000
